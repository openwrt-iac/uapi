#!/bin/sh

# v3 mounts at /api/v3/. On a fresh install we just add it. On an upgrade we strip every
# older mount, because uhttpd would otherwise serve the same main.uc under two prefixes and
# the removed v2 surface would appear to still exist while answering with v3 semantics.
NEW='/api/v3=/usr/share/uapi/main.uc'
OLD='/api/v2=/usr/share/uapi/main.uc /api/v1=/usr/share/uapi/main.uc'

CHANGED=0

for old in $OLD; do
	if uci -q show uhttpd.main.ucode_prefix 2>/dev/null | grep -qF "$old"; then
		uci -q del_list uhttpd.main.ucode_prefix="$old"
		CHANGED=1
	fi
done

if ! uci -q show uhttpd.main.ucode_prefix 2>/dev/null | grep -qF "$NEW"; then
	uci add_list uhttpd.main.ucode_prefix="$NEW"
	CHANGED=1
fi

if [ "$CHANGED" = "1" ]; then
	uci commit uhttpd
	/etc/init.d/uhttpd reload
fi

exit 0
