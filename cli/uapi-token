#!/usr/bin/ucode

'use strict';

push(REQUIRE_SEARCH_PATH, "/usr/share/uapi/lib/*.uc");

import * as fs from 'fs';
let uci_mod = require('uci');
let digest = require('digest');
let scope = require('scope');
let values = require('values');
let token_store = require('token_store');
let transaction = require('transaction');

const PACKAGE = "uapi";
const TOKEN_TYPE = "token";
// uci section-name charset. Hyphens are NOT permitted; libuci rejects with
// "Invalid argument" and ucode-mod-uci silently swallows the failure, so we
// have to catch this at the CLI boundary or the operator gets a fake bearer.
const NAME_RE = /^[A-Za-z0-9_]+$/;

function random_hex(n_bytes) {
	let f = fs.open("/dev/urandom", "r");
	if (!f) die("uapi-token: cannot open /dev/urandom");
	let raw = f.read(n_bytes);
	f.close();
	let hex = "";
	for (let i = 0; i < length(raw); i++)
		hex += sprintf("%02x", ord(raw, i));
	return hex;
}

function hash_bearer(salt, bearer) {
	return digest.sha256(salt + ":" + bearer);
}

function as_list(v) {
	if (v == null) return [];
	if (type(v) == "array") return v;
	return [v];
}

function parse_duration_to_seconds(s) {
	if (type(s) != "string" || s == "") return null;
	let m = match(s, /^([0-9]+)([smhd]?)$/);
	if (!m) return null;
	let n = int(m[1]);
	let suffix = m[2];
	if (suffix == "" || suffix == "s") return n;
	if (suffix == "m") return n * 60;
	if (suffix == "h") return n * 3600;
	if (suffix == "d") return n * 86400;
	return null;
}

function parse_positive_int(s, flag) {
	if (type(s) != "string" || !match(s, /^[1-9][0-9]*$/))
		die(sprintf("uapi-token: %s needs a positive integer", flag));
	return int(s);
}

function parse_args() {
	let cmd = ARGV[0];
	let opts = { name: null, scopes: [], force: false, positional: [],
	             expires_in_seconds: null, allowed_cidrs: [], json: false,
	             rate: null, burst: null };
	let i = 1;
	while (i < length(ARGV)) {
		let a = ARGV[i];
		if (a == "--name") opts.name = ARGV[++i];
		else if (a == "--scope") push(opts.scopes, ARGV[++i]);
		else if (a == "--force") opts.force = true;
		else if (a == "--expires-in") {
			let n = parse_duration_to_seconds(ARGV[++i]);
			if (n == null) die("uapi-token: --expires-in needs <N>[smhd]");
			opts.expires_in_seconds = n;
		}
		else if (a == "--allowed-cidr") push(opts.allowed_cidrs, ARGV[++i]);
		else if (a == "--rate") opts.rate = parse_positive_int(ARGV[++i], "--rate");
		else if (a == "--burst") opts.burst = parse_positive_int(ARGV[++i], "--burst");
		else if (a == "--json") opts.json = true;
		else push(opts.positional, a);
		i++;
	}
	return { cmd, opts };
}

// The HTTP path writes /etc/config/uapi under the locks of a uci transaction on the package, and
// a write here outside them could lose one of the two writes. So create and revoke take the same
// locks before they create their cursor, which loads the package. An HTTP writer holds them for
// milliseconds, which the wait covers. A writer that holds the global lock for longer, such as
// apk, makes the command exit 75 (EX_TEMPFAIL), which a script can retry on, rather than hang a
// shell with no output. A die() under the locks ends the process, and the exit releases them.
const LOCK_WAIT_MS = 10000;

function with_uapi_lock(fn) {
	let lock = transaction.acquire_pkg_waiting(PACKAGE, LOCK_WAIT_MS);
	if (lock.unavailable != null) die("uapi-token: cannot open the lock file " + lock.unavailable);
	if (lock._g == null) {
		fs.stderr.write(sprintf("uapi-token: %s, and it was still held after %d s. Try again.\n",
			(lock.contention == "global") ? "a non-uci write holds the global write lock"
			                              : "another write holds the lock of the uapi package",
			LOCK_WAIT_MS / 1000));
		exit(75);
	}
	fn();
	transaction.default_release_pkg(lock);
}

// The reap that the HTTP mint and revoke run after their commit, under the same locks. This
// command writes through its own uci cursor rather than token_store.create() and remove(), so
// that it works with ubus down. A failed reap must not read as a failed revoke, and the next
// mint or revoke reaps what it left.
function reap(cursor) {
	let tokens = [];
	cursor.foreach(PACKAGE, TOKEN_TYPE, function(s) {
		push(tokens, { name: s['.name'], expires_at: values.as_int(s.expires_at) });
	});
	try { token_store.reap_state(tokens, time()); } catch (_) {}
}

function ensure_package() {
	let path = "/etc/config/" + PACKAGE;
	if (fs.stat(path) != null) return;
	let f = fs.open(path, "w");
	if (!f) die("uapi-token: cannot create " + path);
	f.close();
}

function cmd_create(opts) {
	if (!opts.name) die("uapi-token create: --name required");
	if (!match(opts.name, NAME_RE))
		die(sprintf("uapi-token create: --name %J is invalid (must match [A-Za-z0-9_]+; "
		            + "use underscores instead of hyphens)", opts.name));
	if (length(opts.scopes) == 0) die("uapi-token create: at least one --scope required");

	if (!opts.force)
		for (let s in opts.scopes) scope.validate_against_known_tree(s);

	// Reject malformed --allowed-cidr at mint time. Otherwise a typo silently
	// produces a token that denies every request with `ip_not_permitted` and
	// the operator has no signal what went wrong.
	for (let c in opts.allowed_cidrs) {
		if (!values.is_valid_cidr_any(c))
			die(sprintf("uapi-token create: %J is not a valid IPv4 or IPv6 CIDR", c));
	}

	with_uapi_lock(function() {
		ensure_package();
		let cursor = uci_mod.cursor();

		let exists_already = false;
		cursor.foreach(PACKAGE, TOKEN_TYPE, function(s) {
			if (s['.name'] == opts.name) { exists_already = true; return false; }
		});
		if (exists_already)
			die(sprintf("uapi-token create: token %J already exists", opts.name));

		let bearer = random_hex(16);
		let salt = random_hex(8);
		let hash = hash_bearer(salt, bearer);

		cursor.set(PACKAGE, opts.name, TOKEN_TYPE);
		cursor.set(PACKAGE, opts.name, "salt", salt);
		cursor.set(PACKAGE, opts.name, "hash", hash);
		cursor.set(PACKAGE, opts.name, "scopes", opts.scopes);
		if (opts.expires_in_seconds != null) {
			let now = time();
			cursor.set(PACKAGE, opts.name, "expires_at", "" + (now + opts.expires_in_seconds));
		}
		if (length(opts.allowed_cidrs) > 0)
			cursor.set(PACKAGE, opts.name, "allowed_cidrs", opts.allowed_cidrs);
		if (opts.rate != null)
			cursor.set(PACKAGE, opts.name, "rate", "" + opts.rate);
		if (opts.burst != null)
			cursor.set(PACKAGE, opts.name, "burst", "" + opts.burst);
		if (!cursor.commit(PACKAGE))
			die(sprintf("uapi-token create: cannot commit /etc/config/%s: %s, so token %J does not exist",
			            PACKAGE, cursor.error() ?? "failed", opts.name));

		// Out before the reap, so that an interrupt there cannot lose the bearer of a token
		// that is committed.
		printf("%s\n", bearer);
		fs.stdout.flush();
		fs.stderr.write(sprintf(
			"Token %J created. The cleartext value above is shown only once; store it now.\n",
			opts.name));
		reap(cursor);
	});
}

function cmd_list() {
	let cursor = uci_mod.cursor();
	cursor.foreach(PACKAGE, TOKEN_TYPE, function(s) {
		let scopes = as_list(s.scopes);
		let extra = "";
		if (s.expires_at != null) extra += "\texpires_at=" + s.expires_at;
		if (s.allowed_cidrs != null) extra += "\tallowed_cidrs=" + join(",", as_list(s.allowed_cidrs));
		printf("%s\tscopes=%s%s\n", s['.name'], join(",", scopes), extra);
	});
}

function cmd_show(opts) {
	let name = opts.positional[0];
	if (!name) die("uapi-token show: name required");
	let cursor = uci_mod.cursor();
	let s = cursor.get_all(PACKAGE, name);
	if (!s || s['.type'] != TOKEN_TYPE)
		die(sprintf("uapi-token show: %J not found", name));
	let scopes = as_list(s.scopes);
	printf("name: %s\nscopes:\n", name);
	for (let sc in scopes) printf("  - %s\n", sc);
	if (s.expires_at != null) printf("expires_at: %s\n", s.expires_at);
	if (s.allowed_cidrs != null) {
		printf("allowed_cidrs:\n");
		for (let c in as_list(s.allowed_cidrs)) printf("  - %s\n", c);
	}
	if (s.rate != null)         printf("rate: %s\n", s.rate);
	if (s.burst != null)        printf("burst: %s\n", s.burst);
	if (s.last_used_at != null) printf("last_used_at: %s\n", s.last_used_at);
	if (s.last_used_ip != null) printf("last_used_ip: %s\n", s.last_used_ip);
}

function cmd_scopes(opts) {
	let paths = scope.known_paths();
	if (opts.json) {
		printf("%J\n", paths);
		return;
	}
	for (let p in paths) printf("%s\n", p);
}

function cmd_revoke(opts) {
	let name = opts.positional[0];
	if (!name) die("uapi-token revoke: name required");
	with_uapi_lock(function() {
		let cursor = uci_mod.cursor();
		let s = cursor.get_all(PACKAGE, name);
		if (!s || s['.type'] != TOKEN_TYPE)
			die(sprintf("uapi-token revoke: %J not found", name));
		cursor.delete(PACKAGE, name);
		if (!cursor.commit(PACKAGE))
			die(sprintf("uapi-token revoke: cannot commit /etc/config/%s: %s, so token %J still authenticates",
			            PACKAGE, cursor.error() ?? "failed", name));
		fs.stderr.write(sprintf("Revoked token %J\n", name));
		reap(cursor);
	});
}

function print_help() {
	fs.stderr.write(
"Usage:\n" +
"  uapi-token create --name <name> --scope <scope> [--scope <scope>...]\n" +
"                   [--expires-in <N>[smhd]] [--allowed-cidr <CIDR>...]\n" +
"                   [--rate <N>] [--burst <N>] [--force]\n" +
"  uapi-token list\n" +
"  uapi-token show <name>\n" +
"  uapi-token revoke <name>\n" +
"  uapi-token scopes [--json]\n");
}

let parsed = parse_args();
if (parsed.cmd == "create") cmd_create(parsed.opts);
else if (parsed.cmd == "list") cmd_list();
else if (parsed.cmd == "show") cmd_show(parsed.opts);
else if (parsed.cmd == "revoke") cmd_revoke(parsed.opts);
else if (parsed.cmd == "scopes") cmd_scopes(parsed.opts);
else { print_help(); exit(parsed.cmd == null ? 1 : (parsed.cmd == "help" || parsed.cmd == "--help" ? 0 : 1)); }
